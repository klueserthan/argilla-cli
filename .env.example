# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# argilla-cli reads configuration from (highest precedence first):
#   1. CLI flags (--api-url / --api-key)
#   2. process environment variables
#   3. the selected profile in $XDG_CONFIG_HOME/argilla-cli/config.toml
#   4. this .env file
#
# A .env file is convenient for a single-server, env-only setup. If you
# manage several Argilla servers, prefer profiles: see `argilla-cli config
# set` / `argilla-cli config use` in the README.

# Required: base URL of your Argilla server.
ARGILLA_API_URL=https://argilla.example.com

# Required: an Argilla API key (owner or admin, depending on what you need).
ARGILLA_API_KEY=rbga_your_api_key

# Optional: Hugging Face access token, only needed for `dataset to-hub` /
# `dataset from-hub` and other Hugging Face Hub integrations.
# HF_TOKEN=hf_your_hf_token
